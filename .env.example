# Copy this file to .env for local development (npm run dev).
# Leave TURSO_DATABASE_URL empty to use a local SQLite file in ./data instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Secret path of the admin panel, e.g. /backstage-7f3k. Never linked from the site.
ADMIN_PATH=/admin
# Long random string used to sign login cookies.
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000
